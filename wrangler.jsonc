{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Konfigurasi tingkat atas dipakai untuk development lokal (branch dev, tidak live).
  "name": "workspace-app-dev",
  "main": "apps/api/src/index.ts",
  "compatibility_date": "2025-09-01",
  // Variabel yang diisi lewat dashboard Cloudflare tidak dihapus saat deploy.
  "keep_vars": true,
  "assets": {
    "directory": "apps/web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "workspace-dev",
      "database_id": "57005d5e-a8ac-4fbb-972a-a075ac7e913c",
      "migrations_dir": "apps/api/migrations"
    }
  ],
  "env": {
    // Produksi: deploy dengan `wrangler deploy --env production` dari branch prod.
    "production": {
      "name": "workspace-projects",
      "assets": {
        "directory": "apps/web/dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "workspace-prod",
          "database_id": "e50510a0-b8e3-4ef1-b40d-52e1cd1a3fad",
          "migrations_dir": "apps/api/migrations"
        }
      ]
    }
  }
}
